# --- LLM Provider ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-5-20250929
# Cheap/fast model used for the "LLM-as-judge" secondary security check
JUDGE_MODEL=claude-haiku-4-5-20251001

# --- Server ---
PORT=5000

# --- PostgreSQL (structured data: users, api_keys, policies, rate limits) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_proxy
PG_USER=postgres
PG_PASSWORD=postgres

# --- MongoDB (request logs, security events) ---
MONGO_URI=mongodb://localhost:27017/ai_proxy_logs

# --- Security ---
# Master key used to create the very first API key via /admin/bootstrap
ADMIN_BOOTSTRAP_SECRET=change_this_before_deploying
